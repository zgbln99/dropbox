# --- Admin credentials (used for the web UI login AND WebDAV auth) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# --- Dropbox app credentials ---
# Create an app at https://www.dropbox.com/developers/apps
# Required scopes: files.metadata.read files.content.read files.content.write
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Long-lived refresh token (see README for how to obtain it).
DROPBOX_REFRESH_TOKEN=

# --- App settings ---
# Public URL the portal is served from (used for share links).
APP_URL=https://jrjr.online

# SQLite database location (file: prefix is optional).
DATABASE_URL=file:./data/app.db

# Port the Node server listens on (behind nginx).
PORT=3000
